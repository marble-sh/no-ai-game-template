# C layout for this project — used by the pre-commit hook and editors.
# Style: Allman braces, 4-space indent, 80 columns, aligned consecutive
# assignments. Comments are never reflowed — they are part of the hand-made code.
#
# Requires clang-format >= 15.

Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80

BreakBeforeBraces: Allman
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: false
SpacesBeforeTrailingComments: 1

PointerAlignment: Right
SpaceBeforeParens: ControlStatements

ReflowComments: false
SortIncludes: false
MaxEmptyLinesToKeep: 1
