#!/bin/sh
# Pre-commit: keep staged C sources formatted with clang-format.
#
# Auto-formats staged .c/.h files, re-stages them, and prints what changed.
# One-time setup per clone:  git config core.hooksPath .githooks
# Bypass (rare):             git commit --no-verify
set -u

FMT=""
for c in clang-format clang-format-22 clang-format-21 clang-format-20 clang-format-19 clang-format-18 clang-format-17 clang-format-16 clang-format-15; do
  if command -v "$c" >/dev/null 2>&1; then FMT="$c"; break; fi
done
if [ -z "$FMT" ]; then
  echo "pre-commit: clang-format not found."
  echo "  Install it (e.g. 'sudo apt install clang-format' or 'pacman -S clang')."
  echo "  Or bypass this hook once with: git commit --no-verify"
  exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' || true)
if [ -z "$files" ]; then
  exit 0
fi

tmp=$(mktemp) || exit 1
status=0
for f in $files; do
  [ -f "$f" ] || continue
  if ! "$FMT" "$f" > "$tmp" 2>/dev/null; then
    echo "pre-commit: clang-format failed on $f"
    status=1
    continue
  fi
  if ! cmp -s "$f" "$tmp"; then
    cp "$tmp" "$f"
    git add -- "$f"
    echo "pre-commit: formatted $f"
  fi
done
rm -f "$tmp"
exit "$status"
